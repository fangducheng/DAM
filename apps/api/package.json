{
  "name": "@dam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bootstrap:identity": "tsx src/identity/bootstrap.ts",
    "dev": "node --watch --enable-source-maps --import tsx src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:identity:integration": "vitest run src/identity/identity.integration.spec.ts"
  },
  "dependencies": {
    "@dam/config": "workspace:*",
    "@dam/contracts": "workspace:*",
    "@dam/database": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^9.3.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.10.0",
    "ioredis": "^5.8.0",
    "minio": "^8.0.0",
    "nestjs-pino": "^4.4.0",
    "otplib": "^13.4.1",
    "pino": "^9.9.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0"
  }
}
