{
  "name": "enterprise-dam",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise digital asset management platform",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "pnpm --filter @dam/config build && pnpm --filter @dam/contracts build && pnpm --filter @dam/database build",
    "dev": "pnpm build:packages && concurrently -n api,web -c blue,green \"pnpm --filter @dam/api dev\" \"pnpm --filter @dam/web dev\"",
    "dev:worker": "pnpm build:packages && pnpm --filter @dam/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm build:packages && eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @dam/database generate",
    "db:format": "pnpm --filter @dam/database format",
    "db:validate": "pnpm --filter @dam/database validate",
    "db:migrate": "pnpm --filter @dam/database migrate",
    "identity:bootstrap": "pnpm build:packages && pnpm --filter @dam/api bootstrap:identity",
    "infra:up": "docker compose up -d postgres redis minio minio-init",
    "infra:down": "docker compose down",
    "verify": "pnpm format:check && pnpm lint && pnpm db:validate && pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ]
  }
}
